[Unit]
Description=Mammoth GPU job queue

[Service]
# The service needs mammoth, actl, nvidia-smi, and systemctl; edit these paths to match the host.
ExecStart=%h/.local/bin/mammoth queue serve
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=always

[Install]
WantedBy=default.target
